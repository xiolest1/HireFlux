# Application environment. The recruiter demo uses signed temporary workspaces.
ENVIRONMENT=local
AUTH_MODE=demo
CURSOR_SIGNING_KEY=local-only-signing-key-change-before-deployment
DEMO_SESSION_SIGNING_KEY=local-only-demo-session-signing-key-change-before-deployment
DEMO_SESSION_TTL_HOURS=24
DEMO_SESSION_FAILURE_TTL_MINUTES=15
MAX_APPLICATIONS_PER_WORKSPACE=100
MAX_NOTES_PER_APPLICATION=100
MAX_INTERVIEWS_PER_APPLICATION=25
MAX_ACTIVITY_PER_APPLICATION=500

# Optional fixed development identity, used only when AUTH_MODE=local.
LOCAL_USER_ID=00000000-0000-4000-8000-000000000001
LOCAL_USER_NAME=Local Demo User
LOCAL_USER_EMAIL=local.user@example.com
LOCAL_USER_ROLE=STANDARD_USER

# Local DynamoDB. Omit DYNAMODB_ENDPOINT_URL and explicit credentials in AWS.
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=HireFluxLocal
DYNAMODB_ENDPOINT_URL=http://localhost:8001
AWS_ACCESS_KEY_ID=LOCALFAKEACCESSKEY
AWS_SECRET_ACCESS_KEY=localFakeSecretAccessKeyForDynamoDbLocalOnly

# Comma-separated browser origins. Wildcards are not accepted.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Read by Vite because frontend/vite.config.ts points envDir at the repository root.
VITE_API_BASE_URL=http://localhost:8000
VITE_PUBLIC_SITE_URL=http://localhost:5173
