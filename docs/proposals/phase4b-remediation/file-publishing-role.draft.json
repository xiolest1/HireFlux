{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning"
      ],
      "Resource": "arn:aws:s3:::cdk-hfstage01-assets-${ACCOUNT_ID}-us-east-1"
    },
    {
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::cdk-hfstage01-assets-${ACCOUNT_ID}-us-east-1",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "ee374ad8661035832c785da52fc5ad600c40f8989129b3d62ddd6b18bcf68202.zip",
            "${TEMPLATE_OBJECT_KEY}"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::cdk-hfstage01-assets-${ACCOUNT_ID}-us-east-1/ee374ad8661035832c785da52fc5ad600c40f8989129b3d62ddd6b18bcf68202.zip",
        "arn:aws:s3:::cdk-hfstage01-assets-${ACCOUNT_ID}-us-east-1/${TEMPLATE_OBJECT_KEY}"
      ]
    }
  ]
}
