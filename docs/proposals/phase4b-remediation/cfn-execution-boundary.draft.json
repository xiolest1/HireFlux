{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeTable",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:DescribeContributorInsights",
        "dynamodb:DescribeKinesisStreamingDestination",
        "dynamodb:GetResourcePolicy",
        "dynamodb:ListTagsOfResource",
        "dynamodb:UpdateTable",
        "dynamodb:UpdateTimeToLive",
        "dynamodb:UpdateContinuousBackups",
        "dynamodb:DeleteTable",
        "dynamodb:TagResource",
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetSecretValue",
        "secretsmanager:UpdateSecret",
        "secretsmanager:DeleteSecret",
        "secretsmanager:TagResource",
        "lambda:GetFunction*",
        "lambda:GetPolicy",
        "lambda:ListTags",
        "lambda:GetRuntimeManagementConfig",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:DeleteFunction",
        "lambda:RemovePermission",
        "lambda:PutFunctionConcurrency",
        "lambda:DeleteFunctionConcurrency",
        "lambda:TagResource",
        "logs:PutRetentionPolicy",
        "logs:DeleteLogGroup",
        "logs:ListTagsForResource",
        "logs:TagResource",
        "logs:GetDataProtectionPolicy",
        "apigateway:GET",
        "apigateway:POST",
        "apigateway:PATCH",
        "apigateway:PUT",
        "apigateway:DELETE",
        "amplify:GetApp",
        "amplify:UpdateApp",
        "amplify:DeleteApp",
        "amplify:ListTagsForResource",
        "amplify:TagResource",
        "amplify:GetBranch",
        "amplify:CreateBranch",
        "amplify:UpdateBranch",
        "amplify:DeleteBranch",
        "amplify:ListBranches",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:TagResource",
        "cloudwatch:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:${ACCOUNT_ID}:table/hireflux-staging-workspaces",
        "arn:aws:secretsmanager:us-east-1:${ACCOUNT_ID}:secret:hireflux/staging/cursor-signing-??????",
        "arn:aws:secretsmanager:us-east-1:${ACCOUNT_ID}:secret:hireflux/staging/demo-signing-??????",
        "arn:aws:lambda:us-east-1:${ACCOUNT_ID}:function:hireflux-staging-backend",
        "arn:aws:logs:us-east-1:${ACCOUNT_ID}:log-group:/hireflux/staging/backend",
        "arn:aws:logs:us-east-1:${ACCOUNT_ID}:log-group:/hireflux/staging/backend:*",
        "arn:aws:logs:us-east-1:${ACCOUNT_ID}:log-group:/hireflux/staging/http-api",
        "arn:aws:logs:us-east-1:${ACCOUNT_ID}:log-group:/hireflux/staging/http-api:*",
        "arn:aws:apigateway:us-east-1::/apis/${HTTP_API_ID}",
        "arn:aws:apigateway:us-east-1::/apis/${HTTP_API_ID}/*",
        "arn:aws:amplify:us-east-1:${ACCOUNT_ID}:apps/${AMPLIFY_APP_ID}",
        "arn:aws:amplify:us-east-1:${ACCOUNT_ID}:apps/${AMPLIFY_APP_ID}/branches/main",
        "arn:aws:cloudwatch:us-east-1:${ACCOUNT_ID}:alarm:hireflux-staging-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "secretsmanager:CreateSecret",
        "lambda:CreateFunction",
        "logs:CreateLogGroup"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:${ACCOUNT_ID}:table/hireflux-staging-workspaces",
        "arn:aws:secretsmanager:us-east-1:${ACCOUNT_ID}:secret:hireflux/staging/cursor-signing-??????",
        "arn:aws:secretsmanager:us-east-1:${ACCOUNT_ID}:secret:hireflux/staging/demo-signing-??????",
        "arn:aws:lambda:us-east-1:${ACCOUNT_ID}:function:hireflux-staging-backend",
        "arn:aws:logs:us-east-1:${ACCOUNT_ID}:log-group:/hireflux/staging/backend",
        "arn:aws:logs:us-east-1:${ACCOUNT_ID}:log-group:/hireflux/staging/backend:*",
        "arn:aws:logs:us-east-1:${ACCOUNT_ID}:log-group:/hireflux/staging/http-api",
        "arn:aws:logs:us-east-1:${ACCOUNT_ID}:log-group:/hireflux/staging/http-api:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "HireFlux",
          "aws:RequestTag/Environment": "staging",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "lambda:AddPermission",
      "Resource": "arn:aws:lambda:us-east-1:${ACCOUNT_ID}:function:hireflux-staging-backend",
      "Condition": {
        "StringEquals": {
          "lambda:Principal": "apigateway.amazonaws.com",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricAlarm",
      "Resource": "arn:aws:cloudwatch:us-east-1:${ACCOUNT_ID}:alarm:hireflux-staging-*",
      "Condition": {
        "ForAllValues:ArnEquals": {
          "cloudwatch:AlarmActions": [
            "arn:aws:sns:us-east-1:${ACCOUNT_ID}:hireflux-staging-operational-alerts"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:DescribeResourcePolicies",
        "logs:DescribeIndexPolicies",
        "secretsmanager:GetRandomPassword"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::cdk-hfstage01-assets-${ACCOUNT_ID}-us-east-1/ee374ad8661035832c785da52fc5ad600c40f8989129b3d62ddd6b18bcf68202.zip",
        "arn:aws:s3:::cdk-hfstage01-assets-${ACCOUNT_ID}-us-east-1/${TEMPLATE_OBJECT_KEY}"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${ACCOUNT_ID}:role/hireflux/staging/runtime",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": "arn:aws:iam::${ACCOUNT_ID}:role/hireflux/staging/runtime",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "HireFlux",
          "aws:RequestTag/Environment": "staging",
          "iam:PermissionsBoundary": "arn:aws:iam::${ACCOUNT_ID}:policy/hireflux/staging/RuntimeBoundary"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:DeleteRole",
        "iam:TagRole",
        "cloudwatch:PutDashboard",
        "cloudwatch:GetDashboard",
        "cloudwatch:DeleteDashboards",
        "cloudwatch:TagResource",
        "cloudwatch:ListTagsForResource",
        "budgets:ModifyBudget",
        "budgets:ViewBudget",
        "budgets:TagResource",
        "budgets:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:iam::${ACCOUNT_ID}:role/hireflux/staging/runtime",
        "arn:aws:cloudwatch::${ACCOUNT_ID}:dashboard/hireflux-staging-operations",
        "arn:aws:budgets::${ACCOUNT_ID}:budget/hireflux-staging-monthly-cost"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "iam:*RolePermissionsBoundary",
        "iam:UpdateAssumeRolePolicy",
        "iam:AttachRolePolicy",
        "iam:CreatePolicy*",
        "iam:SetDefaultPolicyVersion",
        "iam:DeletePolicy*",
        "iam:CreateUser",
        "iam:CreateAccessKey",
        "budgets:CreateBudgetAction",
        "budgets:ExecuteBudgetAction",
        "aws-portal:ModifyBilling",
        "organizations:*",
        "controltower:*",
        "freetier:UpgradeAccountPlan",
        "account:CloseAccount"
      ],
      "Resource": "*"
    }
  ]
}
